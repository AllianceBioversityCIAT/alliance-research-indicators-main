ARI_MQ_HOST=xxxxx
ARI_MQ_USER=xxxxx
ARI_MQ_PASSWORD=xxxxx
ARI_PORT=xxxxx
ARI_IS_PRODUCTION=xxxxx
ARI_SEE_ALL_LOGS=xxxxx
ARI_JWT_ACCESS_EXPIRES_IN=xxxxx
ARI_MYSQL_HOST=xxxxx
ARI_MYSQL_USER_NAME=xxxxx
ARI_MYSQL_USER_PASS=xxxxx
ARI_MYSQL_NAME=xxxxx

# TEST datasource target (orm.config.ts dataSourceTarget.TEST), read by the
# sibling module src/db/config/mysql/orm.test.config.ts. These MUST point at a
# DISPOSABLE scratch container (see docker-compose.test.yml / T-01) — NEVER at
# the shared, non-disposable ARI_MYSQL_* database above.
ARI_TEST_MYSQL_HOST=xxxxx
ARI_TEST_MYSQL_PORT=xxxxx
ARI_TEST_MYSQL_USER_NAME=xxxxx
ARI_TEST_MYSQL_USER_PASS=xxxxx
ARI_TEST_MYSQL_NAME=xxxxx

# Optional: comma-separated sheet_key values to override Excel tab order for STAR metadata export (e.g. raw_data,data_dictionary)
ARI_STAR_RESULTS_METADATA_SHEET_ORDER=

# Optional: PNG/JPEG URL for STAR raw-data Excel header logo (defaults to Alliance CDN)
# ARI_STAR_RESULTS_HEADER_LOGO_URL=

# PRMS public-results-framework host — base URL for the ToC integration
# consumed by GET .../pool-funding-alignment/hlos-indicators (T-15.12).
# Same value in dev / staging / prod during the testing wave (2026-05-27).
# When unset, PrmsTocService returns 503 instead of crashing.
ARI_PRMS_TOC_HOST=https://prtest-back.ciat.cgiar.org

# lambda-toc host — base URL for the level-based ToC catalog integration
# consumed by GET .../pool-funding-alignment/hlos-indicators (toc-mapping-v2 T-01).
# No auth headers. When unset, TocIntegrationService returns 503 instead of crashing.
ARI_TOC_INTEGRATION_HOST=https://lambda-toc.clarisa.cgiar.org

# Active CGIAR portfolio used to filter CLARISA project_mappings_array[] (defaults to P25)
# ARI_BILATERAL_ACTIVE_PORTFOLIO=P25

# Accepted CLARISA mapping statuses for Science Programs in the bilateral picker and ToC catalog
# (comma-separated list; defaults to Confirmed,Pending)
# ARI_BILATERAL_ACCEPTED_SP_STATUSES=Confirmed,Pending

# CLARISA project mapping phase — Tier 3 of MappingPhaseResolver's cascade
# (mapping-phase.resolver.ts). Overridden by the app_config row of the same
# key (ARI_CLARISA_PROJECTS_PHASE) when that row is active and holds a
# numeric value; a missing, inactive, blank, or non-numeric row falls
# through to this variable instead (a non-blank non-numeric row also logs
# a warning first). Falls back to the literal default 2026 whenever this
# variable is unset or blank AND the app_config row yields no numeric
# value (missing, inactive, blank, non-numeric, or unreadable) — a bad
# row degrades to the default, it does not fail.
# A non-numeric value HERE is fatal, not ignored: the resolver throws
# BadRequestException and the bilateral picker fails until it is corrected.
# ARI_CLARISA_PROJECTS_PHASE=

# CLARISA API host — consumed by domain/tools/clarisa/clarisa.connection.ts.
# Exactly one of the lines below should be uncommented at a time; switch by
# commenting the active line and uncommenting the target one, THEN RESTART:
# ClarisaProjectsService caches for 5 minutes, so a switch is invisible until
# the TTL lapses or the process restarts, and a stale cache reads as "the
# switch did not work" (design §5.4, K-016).
ARI_CLARISA_HOST=https://clarisatest-back.ciat.cgiar.org/
#ARI_CLARISA_HOST=https://api.clarisa.cgiar.org/

# CLARISA API key — sent as the `x-api-key` header.
# NOT the same credential as ARI_CLARISA_USER / ARI_CLARISA_PASS above: those
# authenticate STAR against CLARISA's own API, while this is a CLARISA-issued
# key identifying the calling platform.
#
# Already consumed by domain/tools/broker/report-ms.app.ts, which reads it
# straight from `process.env`; the AppConfig.ARI_CLARISA_API_KEY getter is the
# preferred access path.
#
# ⚠️ An `app_config` DB row of the SAME NAME also exists (migration
# 1781879906673), read by PdfViewerService, documented as the key for "the IBD
# unit's microservices". Two stores share one name — confirm which a consumer
# means before adding a third.
#
# ⚠️ Whether THIS key is also valid for the PRMS Normalizer ingest API is NOT
# established. PRMS issues keys per tool and per environment and states that a
# key must not be reused across tools, so PRMS ingest most likely needs its own
# value (see docs/specs/bilateral/prms-sync — OQ-F8). Confirm with PRMS Tech
# Support before pointing the sync at this variable.
# ARI_CLARISA_API_KEY=