[
  {
    "id": 1,
    "short_name": "T-PJ-003262-An innovative approach to agribusiness training and start-up for Nigerias young people within the Young Africa Works Program",
    "full_name": "T-PJ-003262-An innovative approach to agribusiness training and start-up for Nigerias young people within the Young Africa Works Program",
    "summary": "This IITA-led project, in partnership with the MasterCard Foundation's Young Africa Works (YAW) Program, aims to enhance self-employment and employment opportunities for Nigerian youth aged 15-35 in agrifood systems across Kaduna, Kano and Lagos. This project focuses on improving education and training systems, connecting youth with agribusinesses and providing access to specialized credit. Key outputs include strengthened training curricula, establishment of Youth Agribusiness Parks and development of youth-sensitive financial support programs. This project targets over 128,000 youth, creating approximately 9,180 new jobs and delivering services through a network of diverse partners. It is set to improve youth engagement and support in agriculture, especially for young women, over five years with a budget of $12.4 million.",
    "description": "An innovative approach to agribusiness training and start-up for Nigerias young people within the Young Africa Works Program",
    "start_date": "2020-05-26",
    "end_date": "2025-05-30",
    "total_budget": "2309550.00",
